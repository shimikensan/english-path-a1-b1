{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Learner account profile and personal study preferences (contains PII, owner or admin read only).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Authentication UID matching document ID."
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Learner full display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200,
          "description": "Learner email address (PII)."
        },
        "currentLevel": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1"],
          "description": "Active CEFR study level."
        },
        "streakDays": {
          "type": "number",
          "description": "Consecutive study days count."
        },
        "lastStudyDate": {
          "type": "string",
          "maxLength": 20,
          "description": "ISO calendar date YYYY-MM-DD of last recorded study activity."
        },
        "dailyGoalMinutes": {
          "type": "number",
          "description": "Daily target study time in minutes."
        },
        "reminderEnabled": {
          "type": "boolean",
          "description": "Whether daily study reminder banner is enabled."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation (immutable)."
        },
        "lastLogin": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of most recent sign-in."
        },
        "totalAccessSeconds": {
          "type": "number",
          "description": "Cumulative active seconds the learner has spent accessing the application (0 to 315360000)."
        }
      },
      "required": [
        "uid",
        "fullName",
        "email",
        "currentLevel",
        "streakDays",
        "lastStudyDate",
        "dailyGoalMinutes",
        "reminderEnabled",
        "createdAt",
        "lastLogin"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-checked RBAC admin registry granting administrative access.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
