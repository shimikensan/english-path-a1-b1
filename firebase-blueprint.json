          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "configId",
        "mode",
        "title",
        "artist",
        "audioUrl",
        "fileName",
        "storedFileName",
        "mimeType",
        "fileSizeBytes",
        "defaultVolume",
        "enabled",
        "updatedBy",
        "updatedByName",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private learner profile documents isolated to owner and admins."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Server-verified administrator registry."
    },
    "/admin_security/{configId}": {
      "schema": { "$ref": "#/entities/AdminSecurityVault" },
      "description": "Admin-only salted PBKDF2-SHA256 hash for secondary admin management password gate."
    },
    "/levels/{levelId}": {
      "schema": { "$ref": "#/entities/Level" },
      "description": "CEFR level catalog managed by administrators."
    },
    "/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/Lesson" },
      "description": "CEFR lessons containing vocabulary, sentence patterns, grammar, and quiz banks."
    },
    "/user_progress/{progressId}": {
      "schema": { "$ref": "#/entities/UserProgress" },
      "description": "Per-user lesson progress keyed by {uid}_{lessonId}."
    },
    "/quiz_results/{resultId}": {
      "schema": { "$ref": "#/entities/QuizResult" },
      "description": "Immutable quiz attempt scores owned by the submitting learner."
    },
    "/user_vocabulary/{vocabDocId}": {
      "schema": { "$ref": "#/entities/UserVocabulary" },
      "description": "Per-user learned and favorite vocabulary items keyed by {uid}_{vocabularyId}."
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public PII-free completion leaderboard readable by visitors and signed-in learners."
    },
    "/user_feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/UserFeedback" },
      "description": "Learner feedback tickets and admin responses for continuous software and curriculum improvement."
    },
    "/reading_passages/{passageId}": {
      "schema": { "$ref": "#/entities/ReadingPassage" },
      "description": "Bilingual English-Vietnamese reading comprehension flashcard articles managed by administrators."
    },
    "/revoked_users/{userId}": {
      "schema": { "$ref": "#/entities/RevokedUser" },
      "description": "Revoked/deleted learner account registry enforced by Security Rules to block profile recreation."
    },
    "/club_members/{userId}": {
      "schema": { "$ref": "#/entities/ClubMember" },
      "description": "PII-free 3D English Club avatars and presence state."
    },
    "/club_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ClubMessage" },
      "description": "Private 1-on-1 English practice messages between two 3D English Club members."
    },
    "/club_settings/{configId}": {
      "schema": { "$ref": "#/entities/ClubMusicConfig" },
      "description": "3D English Club global background music settings managed by administrators."
    }
  }
}
