rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnedCompositeId(docId) {
      return isSignedIn()
        && docId.size() > request.auth.uid.size() + 1
        && docId[0:request.auth.uid.size() + 1] == request.auth.uid + '_';
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'buocngoat2020@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isRevokedUser() {
      return isSignedIn()
        && !isBootstrappedAdmin()
        && exists(/databases/$(database)/documents/revoked_users/$(request.auth.uid));
    }

    // --- Entity Validation Blueprints (Anti-Update-Gap) ---
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid', 'fullName', 'email', 'currentLevel', 'streakDays',
          'lastStudyDate', 'dailyGoalMinutes', 'reminderEnabled', 'createdAt', 'lastLogin'
        ])
        && data.keys().hasOnly([
          'uid', 'fullName', 'email', 'currentLevel', 'streakDays',
          'lastStudyDate', 'dailyGoalMinutes', 'reminderEnabled', 'createdAt', 'lastLogin',
          'totalAccessSeconds'
        ])
        && isValidId(data.uid)
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.currentLevel is string && data.currentLevel in ['A1', 'A2', 'B1', 'B2', 'C1']
        && data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000
        && data.lastStudyDate is string && data.lastStudyDate.size() <= 20
        && data.dailyGoalMinutes is number && data.dailyGoalMinutes >= 5 && data.dailyGoalMinutes <= 240
        && data.reminderEnabled is bool
        && data.createdAt is timestamp
        && data.lastLogin is timestamp
        && (!('totalAccessSeconds' in data) || (data.totalAccessSeconds is number && data.totalAccessSeconds >= 0 && data.totalAccessSeconds <= 315360000));
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidAdminSecurityVault(data) {
      return data.keys().hasAll([
          'configId', 'algorithm', 'iterations', 'saltHex', 'hashHex',
          'updatedBy', 'updatedByEmail', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'configId', 'algorithm', 'iterations', 'saltHex', 'hashHex',
          'updatedBy', 'updatedByEmail', 'createdAt', 'updatedAt'
        ])
        && data.configId == 'vault'
        && data.algorithm == 'PBKDF2-SHA256'
        && data.iterations is number && data.iterations >= 100000 && data.iterations <= 500000
        && data.saltHex is string && data.saltHex.size() >= 16 && data.saltHex.size() <= 128 && data.saltHex.matches('^[0-9a-f]+$')
        && data.hashHex is string && data.hashHex.size() >= 32 && data.hashHex.size() <= 128 && data.hashHex.matches('^[0-9a-f]+$')
        && isValidId(data.updatedBy) && data.updatedBy == request.auth.uid
        && data.updatedByEmail is string && data.updatedByEmail.size() >= 3 && data.updatedByEmail.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLevel(data) {
      return data.keys().hasAll(['levelId', 'name', 'subtitle', 'description', 'order', 'isPublished', 'updatedAt'])
        && data.keys().hasOnly(['levelId', 'name', 'subtitle', 'description', 'order', 'isPublished', 'updatedAt'])
        && isValidId(data.levelId) && data.levelId.size() <= 32
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.subtitle is string && data.subtitle.size() <= 150
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 600
        && data.order is number && data.order >= 1 && data.order <= 100
        && data.isPublished is bool
        && data.updatedAt is timestamp;
    }

    function isValidLesson(data) {
      return data.keys().hasAll([
          'lessonId', 'levelId', 'topic', 'topicOrder', 'title', 'description',
          'order', 'estimatedMinutes', 'isPublished', 'vocabulary', 'sentencePatterns',
          'grammar', 'quiz', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'lessonId', 'levelId', 'topic', 'topicOrder', 'title', 'description',
          'order', 'estimatedMinutes', 'isPublished', 'vocabulary', 'sentencePatterns',
          'grammar', 'quiz', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.lessonId) && data.lessonId.size() <= 80
        && isValidId(data.levelId) && data.levelId.size() <= 32
        && data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 120
        && data.topicOrder is number && data.topicOrder >= 1 && data.topicOrder <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 600
        && data.order is number && data.order >= 1 && data.order <= 500
        && data.estimatedMinutes is number && data.estimatedMinutes >= 5 && data.estimatedMinutes <= 180
        && data.isPublished is bool
        && data.vocabulary is list && data.vocabulary.size() <= 40
        && (data.vocabulary.size() == 0 || data.vocabulary[0] is map)
        && data.sentencePatterns is list && data.sentencePatterns.size() <= 20
        && (data.sentencePatterns.size() == 0 || data.sentencePatterns[0] is map)
        && data.grammar is map
        && data.quiz is list && data.quiz.size() <= 40
        && (data.quiz.size() == 0 || data.quiz[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll([
          'uid', 'lessonId', 'levelId', 'vocabularyLearned', 'lessonCompleted',
          'quizBestScore', 'quizAttempts', 'createdAt', 'lastStudyAt'
        ])
        && data.keys().hasOnly([
          'uid', 'lessonId', 'levelId', 'vocabularyLearned', 'lessonCompleted',
          'quizBestScore', 'quizAttempts', 'createdAt', 'lastStudyAt'
        ])
        && isValidId(data.uid)
        && isValidId(data.lessonId) && data.lessonId.size() <= 80
        && isValidId(data.levelId) && data.levelId.size() <= 32
        && data.vocabularyLearned is list && data.vocabularyLearned.size() <= 40
        && (data.vocabularyLearned.size() == 0 || data.vocabularyLearned[0] is string)
        && data.lessonCompleted is bool
        && data.quizBestScore is number && data.quizBestScore >= 0 && data.quizBestScore <= 100
        && data.quizAttempts is number && data.quizAttempts >= 0 && data.quizAttempts <= 1000
        && data.createdAt is timestamp
        && data.lastStudyAt is timestamp;
    }

    function isValidQuizResult(data) {
      return data.keys().hasAll([
          'uid', 'lessonId', 'lessonTitle', 'levelId', 'score', 'totalQuestions',
          'correctAnswers', 'wrongAnswers', 'rating', 'durationSeconds', 'completedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'lessonId', 'lessonTitle', 'levelId', 'score', 'totalQuestions',
          'correctAnswers', 'wrongAnswers', 'rating', 'durationSeconds', 'completedAt'
        ])
        && isValidId(data.uid)
        && isValidId(data.lessonId) && data.lessonId.size() <= 80
        && data.lessonTitle is string && data.lessonTitle.size() >= 1 && data.lessonTitle.size() <= 160
        && isValidId(data.levelId) && data.levelId.size() <= 32
        && data.score is number && data.score >= 0 && data.score <= 100
        && data.totalQuestions is number && data.totalQuestions >= 1 && data.totalQuestions <= 100
        && data.correctAnswers is number && data.correctAnswers >= 0 && data.correctAnswers <= 100
        && data.wrongAnswers is number && data.wrongAnswers >= 0 && data.wrongAnswers <= 100
        && data.correctAnswers + data.wrongAnswers == data.totalQuestions
        && data.rating is string && data.rating in ['Excellent', 'Very Good', 'Good', 'Need More Practice', 'Keep Learning']
        && data.durationSeconds is number && data.durationSeconds >= 0 && data.durationSeconds <= 7200
        && data.completedAt is timestamp;
    }

    function isValidUserVocabulary(data) {
      return data.keys().hasAll([
          'uid', 'vocabularyId', 'lessonId', 'levelId', 'word', 'ipa',
          'partOfSpeech', 'meaningVi', 'exampleEn', 'exampleVi',
          'isFavorite', 'isLearned', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'vocabularyId', 'lessonId', 'levelId', 'word', 'ipa',
          'partOfSpeech', 'meaningVi', 'exampleEn', 'exampleVi',
          'isFavorite', 'isLearned', 'updatedAt'
        ])
        && isValidId(data.uid)
        && isValidId(data.vocabularyId) && data.vocabularyId.size() <= 80
        && isValidId(data.lessonId) && data.lessonId.size() <= 80
        && isValidId(data.levelId) && data.levelId.size() <= 32
        && data.word is string && data.word.size() >= 1 && data.word.size() <= 100
        && data.ipa is string && data.ipa.size() <= 100
        && data.partOfSpeech is string && data.partOfSpeech.size() >= 1 && data.partOfSpeech.size() <= 40
        && data.meaningVi is string && data.meaningVi.size() >= 1 && data.meaningVi.size() <= 250
        && data.exampleEn is string && data.exampleEn.size() <= 350
        && data.exampleVi is string && data.exampleVi.size() <= 350
        && data.isFavorite is bool
        && data.isLearned is bool
        && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'currentLevel', 'completedLessons', 'totalLessons',
          'completionPercent', 'learnedVocabCount', 'averageQuizScore', 'streakDays',
          'isPublic', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'currentLevel', 'completedLessons', 'totalLessons',
          'completionPercent', 'learnedVocabCount', 'averageQuizScore', 'streakDays',
          'gemsEarned', 'totalAccessSeconds', 'firstLoginAt', 'pilotEquipped', 'isPublic', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.currentLevel is string && data.currentLevel in ['A1', 'A2', 'B1', 'B2', 'C1']
        && data.completedLessons is number && data.completedLessons >= 0 && data.completedLessons <= 500
        && data.totalLessons is number && data.totalLessons >= 1 && data.totalLessons <= 500
        && data.completionPercent is number && data.completionPercent >= 0 && data.completionPercent <= 100
        && data.learnedVocabCount is number && data.learnedVocabCount >= 0 && data.learnedVocabCount <= 5000
        && data.averageQuizScore is number && data.averageQuizScore >= 0 && data.averageQuizScore <= 100
        && data.streakDays is number && data.streakDays >= 0 && data.streakDays <= 10000
        && (!('gemsEarned' in data) || (data.gemsEarned is number && data.gemsEarned >= 0 && data.gemsEarned <= 10000000))
        && (!('totalAccessSeconds' in data) || (data.totalAccessSeconds is number && data.totalAccessSeconds >= 0 && data.totalAccessSeconds <= 315360000))
        && (!('firstLoginAt' in data) || data.firstLoginAt is timestamp)
        && (!('pilotEquipped' in data) || (
          data.pilotEquipped is map
          && data.pilotEquipped.keys().hasOnly(['helmet', 'goggles', 'suit', 'scarf', 'backpack', 'companion', 'aircraft'])
          && data.pilotEquipped.keys().hasAll(['helmet', 'goggles', 'suit', 'scarf', 'backpack', 'companion'])
          && isValidId(data.pilotEquipped.helmet)
          && isValidId(data.pilotEquipped.goggles)
          && isValidId(data.pilotEquipped.suit)
          && isValidId(data.pilotEquipped.scarf)
          && isValidId(data.pilotEquipped.backpack)
          && isValidId(data.pilotEquipped.companion)
          && (!('aircraft' in data.pilotEquipped) || isValidId(data.pilotEquipped.aircraft))
        ))
        && data.isPublic is bool
        && data.updatedAt is timestamp;
    }

    function isValidUserFeedback(data) {
      return data.keys().hasAll([
          'uid', 'userName', 'userEmail', 'userLevel', 'category', 'contextPage',
          'title', 'content', 'rating', 'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'userName', 'userEmail', 'userLevel', 'category', 'contextPage',
          'title', 'content', 'rating', 'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 200
        && data.userLevel is string && data.userLevel in ['A1', 'A2', 'B1', 'B2', 'C1']
        && data.category is string && data.category in ['bug', 'content', 'feature', 'ui_ux', 'other']
        && data.contextPage is string && data.contextPage.size() <= 80
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.content is string && data.content.size() >= 5 && data.content.size() <= 2000
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.status is string && data.status in ['new', 'reviewing', 'resolved', 'closed']
        && data.adminNote is string && data.adminNote.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReadingPassage(data) {
      return data.keys().hasAll([
          'passageId', 'titleEn', 'titleVi', 'levelId', 'category',
          'contentEn', 'contentVi', 'keyPhrases', 'estimatedMinutes',
          'order', 'isPublished', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'passageId', 'titleEn', 'titleVi', 'levelId', 'category',
          'contentEn', 'contentVi', 'keyPhrases', 'estimatedMinutes',
          'order', 'isPublished', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.passageId) && data.passageId.size() <= 80
        && data.titleEn is string && data.titleEn.size() >= 1 && data.titleEn.size() <= 160
        && data.titleVi is string && data.titleVi.size() >= 1 && data.titleVi.size() <= 160
        && data.levelId is string && data.levelId in ['A1', 'A2', 'B1', 'B2', 'C1']
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.contentEn is string && data.contentEn.size() >= 10 && data.contentEn.size() <= 3000
        && data.contentVi is string && data.contentVi.size() >= 10 && data.contentVi.size() <= 3500
        && data.keyPhrases is list && data.keyPhrases.size() <= 12
        && (data.keyPhrases.size() == 0 || data.keyPhrases[0] is map)
        && data.estimatedMinutes is number && data.estimatedMinutes >= 1 && data.estimatedMinutes <= 30
        && data.order is number && data.order >= 1 && data.order <= 500
        && data.isPublished is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRevokedUser(data) {
      return data.keys().hasAll([
          'uid', 'email', 'fullName', 'reason', 'revokedBy', 'revokedByEmail', 'revokedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'fullName', 'reason', 'revokedBy', 'revokedByEmail', 'revokedAt'
        ])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100
        && data.reason is string && data.reason.size() <= 300
        && isValidId(data.revokedBy) && data.revokedBy == request.auth.uid
        && data.revokedByEmail is string && data.revokedByEmail.size() >= 3 && data.revokedByEmail.size() <= 200
        && data.revokedAt is timestamp;
    }

    function isValidClubPilotEquipped(gear) {
      return gear is map
        && gear.keys().hasAll(['helmet', 'goggles', 'suit', 'scarf', 'backpack', 'companion'])
        && gear.keys().hasOnly(['helmet', 'goggles', 'suit', 'scarf', 'backpack', 'companion'])
        && isValidId(gear.helmet)
        && isValidId(gear.goggles)
        && isValidId(gear.suit)
        && isValidId(gear.scarf)
        && isValidId(gear.backpack)
        && isValidId(gear.companion);
    }

    function isValidClubMember(data) {
      return data.keys().hasAll([
          'uid', 'displayName', 'currentLevel', 'avatarGender', 'statusText',
          'posX', 'posZ', 'rotationY', 'isOnline', 'joinedAt', 'lastActiveAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'currentLevel', 'avatarGender', 'pilotEquipped',
          'statusText', 'posX', 'posZ', 'rotationY', 'isOnline', 'joinedAt', 'lastActiveAt'
        ])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.currentLevel is string && data.currentLevel in ['A1', 'A2', 'B1', 'B2', 'C1']
        && data.avatarGender is string && data.avatarGender in ['male', 'female']
        && (!('pilotEquipped' in data) || isValidClubPilotEquipped(data.pilotEquipped))
        && data.statusText is string && data.statusText.size() <= 120
        && data.posX is number && data.posX >= -20 && data.posX <= 20
        && data.posZ is number && data.posZ >= -20 && data.posZ <= 20
        && data.rotationY is number && data.rotationY >= -10 && data.rotationY <= 10
        && data.isOnline is bool
        && data.joinedAt is timestamp
        && data.lastActiveAt is timestamp;
    }

    function isValidClubMessage(data) {
      return data.keys().hasAll([
          'pairId', 'participants', 'senderUid', 'senderName',
          'senderAvatar', 'receiverUid', 'text', 'createdAt'
        ])
        && data.keys().hasOnly([
          'pairId', 'participants', 'senderUid', 'senderName',
          'senderAvatar', 'receiverUid', 'text', 'createdAt'
        ])
        && data.pairId is string && data.pairId.size() >= 3 && data.pairId.size() <= 260 && data.pairId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.participants is list && data.participants.size() == 2
        && data.participants[0] is string && data.participants[1] is string
        && isValidId(data.senderUid)
        && isValidId(data.receiverUid)
        && data.senderUid != data.receiverUid
        && data.senderUid in data.participants
        && data.receiverUid in data.participants
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100
        && data.senderAvatar is string && data.senderAvatar in ['male', 'female']
        && data.text is string && data.text.size() >= 1 && data.text.size() <= 1000
        && data.createdAt is timestamp;
    }

    function isValidClubMusicConfig(data) {
      return data.keys().hasAll([
          'configId', 'mode', 'title', 'artist', 'audioUrl', 'fileName',
          'storedFileName', 'mimeType', 'fileSizeBytes', 'defaultVolume',
          'enabled', 'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'configId', 'mode', 'title', 'artist', 'audioUrl', 'fileName',
          'storedFileName', 'mimeType', 'fileSizeBytes', 'defaultVolume',
          'enabled', 'updatedBy', 'updatedByName', 'updatedAt'
        ])
        && data.configId is string && data.configId == 'music'
        && data.mode is string && data.mode in ['builtin_see_you_again', 'uploaded']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.artist is string && data.artist.size() <= 100
        && data.audioUrl is string && data.audioUrl.size() <= 300
        && (
          (data.mode == 'builtin_see_you_again' && data.audioUrl == '')
          || (
            data.mode == 'uploaded'
            && data.audioUrl.matches('^/api/club/music/files/club_bgm_[0-9]+_[a-f0-9]{12}\\.(mp3|wav|ogg|m4a|webm)$')
          )
        )
        && data.fileName is string && data.fileName.size() <= 160
        && data.storedFileName is string && data.storedFileName.size() <= 120
        && data.mimeType is string && data.mimeType.size() <= 60
        && data.fileSizeBytes is number && data.fileSizeBytes >= 0 && data.fileSizeBytes <= 20971520
        && data.defaultVolume is number && data.defaultVolume >= 0 && data.defaultVolume <= 1
        && data.enabled is bool
        && isValidId(data.updatedBy) && data.updatedBy == request.auth.uid
        && data.updatedByName is string && data.updatedByName.size() >= 1 && data.updatedByName.size() <= 100
        && data.updatedAt is timestamp;
    }

    function isValidPilotHangar(data) {
      return data.keys().hasOnly([
          'uid', 'ownedItemIds', 'equipped', 'spentGems', 'bonusGems', 'updatedAt'
        ])
        && data.keys().hasAll([
          'uid', 'ownedItemIds', 'equipped', 'spentGems', 'bonusGems', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.ownedItemIds is list
        && data.ownedItemIds.size() >= 1
        && data.ownedItemIds.size() <= 60
        && data.equipped is map
        && data.equipped.keys().hasOnly(['helmet', 'goggles', 'suit', 'scarf', 'backpack', 'companion', 'aircraft'])
        && data.equipped.keys().hasAll(['helmet', 'goggles', 'suit', 'scarf', 'backpack', 'companion'])
        && isValidId(data.equipped.helmet)
        && isValidId(data.equipped.goggles)
        && isValidId(data.equipped.suit)
        && isValidId(data.equipped.scarf)
        && isValidId(data.equipped.backpack)
        && isValidId(data.equipped.companion)
        && (!('aircraft' in data.equipped) || isValidId(data.equipped.aircraft))
        && data.spentGems is int && data.spentGems >= 0 && data.spentGems <= 1000000
        && data.bonusGems is int && data.bonusGems >= 0 && data.bonusGems <= 1000000
        && data.updatedAt is timestamp;
    }

    function isToeicGroupMember(groupId) {
      return isSignedIn()
        && isValidId(groupId)
        && exists(/databases/$(database)/documents/toeic_groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/toeic_groups/$(groupId)).data.memberUids;
    }

    function isToeicGroupCreator(groupId) {
      return isSignedIn()
        && isValidId(groupId)
        && exists(/databases/$(database)/documents/toeic_groups/$(groupId))
        && get(/databases/$(database)/documents/toeic_groups/$(groupId)).data.creatorUid == request.auth.uid;
    }

    function isValidToeicGroupBadge(badge) {
      return badge is map
        && badge.keys().hasAll(['shape', 'icon', 'paletteId', 'pattern', 'frame', 'monogram', 'motto'])
        && badge.keys().hasOnly(['shape', 'icon', 'paletteId', 'pattern', 'frame', 'monogram', 'motto'])
        && badge.shape is string && badge.shape in ['shield', 'hexagon', 'wings', 'crest', 'diamond', 'circle']
        && badge.icon is string && badge.icon in ['plane', 'crown', 'trophy', 'bolt', 'book', 'compass', 'star', 'flame']
        && badge.paletteId is string && badge.paletteId in [
          'pilot_orange', 'navy_gold', 'emerald_ace', 'royal_violet',
          'crimson_jet', 'arctic_cyan', 'obsidian_amber', 'rose_squad'
        ]
        && badge.pattern is string && badge.pattern in ['solid', 'stripes', 'rays', 'grid']
        && badge.frame is string && badge.frame in ['classic', 'double', 'laurel', 'wings_trim']
        && badge.monogram is string && badge.monogram.size() <= 4
        && (badge.monogram.size() == 0 || badge.monogram.matches('^[A-Z0-9+]{1,4}$'))
        && badge.motto is string && badge.motto.size() <= 28;
    }

    function isValidToeicGroup(data) {
      return data.keys().hasAll([
          'groupId', 'name', 'description', 'inviteCode', 'targetScore',
          'maxMembers', 'creatorUid', 'creatorName', 'memberUids', 'members',
          'isPublic', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'groupId', 'name', 'description', 'inviteCode', 'targetScore',
          'maxMembers', 'creatorUid', 'creatorName', 'memberUids', 'members',
          'isPublic', 'badge', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.groupId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 240
        && data.inviteCode is string && data.inviteCode.size() >= 6 && data.inviteCode.size() <= 10
        && data.inviteCode.matches('^[A-Z0-9]+$')
        && data.targetScore is number && data.targetScore >= 450 && data.targetScore <= 990
        && data.maxMembers is int && data.maxMembers >= 2 && data.maxMembers <= 12
        && isValidId(data.creatorUid)
        && data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 100
        && data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 12
        && data.memberUids[0] is string
        && data.members is map && data.members.size() >= 1 && data.members.size() <= 12
        && data.memberUids.size() == data.members.size()
        && data.isPublic is bool
        && (!('badge' in data) || isValidToeicGroupBadge(data.badge))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidToeicGroupVocab(data) {
      return data.keys().hasAll([
          'entryId', 'groupId', 'word', 'ipa', 'partOfSpeech', 'meaningVi',
          'exampleEn', 'exampleVi', 'noteVi', 'topicLabel', 'sourceVocabId',
          'sourceLessonId', 'sharedByUid', 'sharedByName', 'likedByUids',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'entryId', 'groupId', 'word', 'ipa', 'partOfSpeech', 'meaningVi',
          'exampleEn', 'exampleVi', 'noteVi', 'topicLabel', 'sourceVocabId',
          'sourceLessonId', 'sharedByUid', 'sharedByName', 'likedByUids',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.entryId)
        && isValidId(data.groupId)
        && data.word is string && data.word.size() >= 1 && data.word.size() <= 80
        && data.ipa is string && data.ipa.size() <= 80
        && data.partOfSpeech is string && data.partOfSpeech.size() >= 1 && data.partOfSpeech.size() <= 30
        && data.meaningVi is string && data.meaningVi.size() >= 1 && data.meaningVi.size() <= 240
        && data.exampleEn is string && data.exampleEn.size() <= 320
        && data.exampleVi is string && data.exampleVi.size() <= 320
        && data.noteVi is string && data.noteVi.size() <= 280
        && data.topicLabel is string && data.topicLabel.size() <= 100
        && data.sourceVocabId is string && data.sourceVocabId.size() <= 80
        && data.sourceLessonId is string && data.sourceLessonId.size() <= 80
        && isValidId(data.sharedByUid)
        && data.sharedByName is string && data.sharedByName.size() >= 1 && data.sharedByName.size() <= 100
        && data.likedByUids is list && data.likedByUids.size() <= 12
        && (data.likedByUids.size() == 0 || data.likedByUids[0] is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidToeicGroupChallenge(data) {
      return data.keys().hasAll([
          'challengeId', 'groupId', 'title', 'scopeLabel', 'hostUid', 'hostName',
          'status', 'questionCount', 'timeLimitSeconds', 'questions',
          'participantUids', 'participants', 'startedAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'challengeId', 'groupId', 'title', 'scopeLabel', 'hostUid', 'hostName',
          'status', 'questionCount', 'timeLimitSeconds', 'questions',
          'participantUids', 'participants', 'isQuickChallenge', 'invitedUids',
          'startedAtMs', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.challengeId)
        && isValidId(data.groupId)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.scopeLabel is string && data.scopeLabel.size() >= 1 && data.scopeLabel.size() <= 120
        && isValidId(data.hostUid)
        && data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 100
        && data.status is string && data.status in ['waiting', 'active', 'finished']
        && data.questionCount is int && data.questionCount >= 3 && data.questionCount <= 15
        && data.timeLimitSeconds is int && data.timeLimitSeconds >= 30 && data.timeLimitSeconds <= 600
        && data.questions is list && data.questions.size() == data.questionCount
        && data.questions[0] is map
        && data.participantUids is list && data.participantUids.size() >= 1 && data.participantUids.size() <= 12
        && data.participantUids[0] is string
        && data.participants is map && data.participants.size() >= 1 && data.participants.size() <= 12
        && data.participantUids.size() == data.participants.size()
        && (!('isQuickChallenge' in data) || data.isQuickChallenge is bool)
        && (!('invitedUids' in data) || (
          data.invitedUids is list
          && data.invitedUids.size() <= 12
          && (data.invitedUids.size() == 0 || data.invitedUids[0] is string)
        ))
        && data.startedAtMs is number && data.startedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: users (PII Isolated to Owner & Admin) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && !isRevokedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && request.auth.uid == userId
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().lastLogin == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && (
          (
            isOwner(userId)
            && !isRevokedUser()
            && incoming().uid == existing().uid
            && incoming().email == existing().email
            && incoming().createdAt == existing().createdAt
            && (
              (
                incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'currentLevel', 'dailyGoalMinutes', 'reminderEnabled', 'lastLogin'])
                && incoming().lastLogin == request.time
              )
              || (
                incoming().diff(existing()).affectedKeys().hasOnly(['streakDays', 'lastStudyDate', 'lastLogin'])
                && incoming().lastLogin == request.time
              )
              || (
                incoming().diff(existing()).affectedKeys().hasOnly(['totalAccessSeconds', 'lastLogin'])
                && incoming().lastLogin == request.time
                && (!('totalAccessSeconds' in existing()) || incoming().totalAccessSeconds >= existing().totalAccessSeconds)
              )
              || (
                incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin'])
                && incoming().lastLogin == request.time
              )
            )
          )
          || isAdmin()
        );
      allow delete: if isValidId(userId)
        && isAdmin()
        && userId != request.auth.uid
        && existing().email.lower() != 'buocngoat2020@gmail.com';
    }

    // --- Collection: admins (Server-Enforced RBAC Registry) ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(adminId)
        && isValidAdminRecord(incoming())
        && incoming().uid == adminId
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminId)
        && isAdmin()
        && adminId != request.auth.uid
        && existing().email.lower() != 'buocngoat2020@gmail.com';
    }

    // --- Collection: revoked_users (Admin Account Deletion & Access Block Registry) ---
    match /revoked_users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(userId)
        && userId != request.auth.uid
        && isValidRevokedUser(incoming())
        && incoming().uid == userId
        && incoming().email.lower() != 'buocngoat2020@gmail.com'
        && incoming().revokedAt == request.time;
      allow update: if false;
      allow delete: if isValidId(userId) && isAdmin();
    }

    // --- Collection: admin_security (Admin Vault Password Hash) ---
    match /admin_security/{configId} {
      allow get: if isValidId(configId) && configId == 'vault' && isAdmin();
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(configId)
        && configId == 'vault'
        && isValidAdminSecurityVault(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerifiedUser()
        && isValidId(configId)
        && configId == 'vault'
        && isValidAdminSecurityVault(incoming())
        && incoming().configId == existing().configId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'algorithm', 'iterations', 'saltHex', 'hashHex', 'updatedBy', 'updatedByEmail', 'updatedAt'
        ])
        && isAdmin();
      allow delete: if isValidId(configId) && configId == 'vault' && isBootstrappedAdmin();
    }

    // --- Collection: levels ---
    match /levels/{levelId} {
      allow get: if isValidId(levelId) && (isAdmin() || (isSignedIn() && resource != null && existing().isPublished == true));
      allow list: if (isSignedIn() && existing().isPublished == true) || isAdmin();
      allow create: if isAdmin()
        && isValidId(levelId)
        && isValidLevel(incoming())
        && incoming().levelId == levelId
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(levelId)
        && isValidLevel(incoming())
        && incoming().levelId == existing().levelId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'subtitle', 'description', 'order', 'isPublished', 'updatedAt']);
      allow delete: if isValidId(levelId) && isAdmin();
    }

    // --- Collection: lessons ---
    match /lessons/{lessonId} {
      allow get: if isValidId(lessonId) && (isAdmin() || (isSignedIn() && resource != null && existing().isPublished == true));
      allow list: if (isSignedIn() && existing().isPublished == true) || isAdmin();
      allow create: if isAdmin()
        && isValidId(lessonId)
        && isValidLesson(incoming())
        && incoming().lessonId == lessonId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(lessonId)
        && isValidLesson(incoming())
        && incoming().lessonId == existing().lessonId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'levelId', 'topic', 'topicOrder', 'title', 'description', 'order',
          'estimatedMinutes', 'isPublished', 'vocabulary', 'sentencePatterns',
          'grammar', 'quiz', 'updatedAt'
        ]);
      allow delete: if isValidId(lessonId) && isAdmin();
    }

    // --- Collection: user_progress ---
    match /user_progress/{progressId} {
      allow get: if isValidId(progressId) && (
        isAdmin()
        || (
          isSignedIn() && (
            (resource == null && isOwnedCompositeId(progressId))
            || (resource != null && existing().uid == request.auth.uid)
          )
        )
      );
      allow list: if (isSignedIn() && existing().uid == request.auth.uid) || isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(progressId)
        && isValidUserProgress(incoming())
        && incoming().uid == request.auth.uid
        && progressId == request.auth.uid + '_' + incoming().lessonId
        && incoming().createdAt == request.time
        && incoming().lastStudyAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser()
        && isValidId(progressId)
        && isValidUserProgress(incoming())
        && (
          (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().lessonId == existing().lessonId
            && incoming().levelId == existing().levelId
            && incoming().createdAt == existing().createdAt
            && incoming().lastStudyAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'vocabularyLearned', 'lessonCompleted', 'quizBestScore', 'quizAttempts', 'lastStudyAt'
            ])
          )
          || isAdmin()
        );
      allow delete: if isValidId(progressId) && isAdmin();
    }

    // --- Collection: quiz_results (Immutable Score Records) ---
    match /quiz_results/{resultId} {
      allow get: if isValidId(resultId) && (isAdmin() || (isSignedIn() && resource != null && existing().uid == request.auth.uid));
      allow list: if (isSignedIn() && existing().uid == request.auth.uid) || isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(resultId)
        && isValidQuizResult(incoming())
        && incoming().uid == request.auth.uid
        && incoming().completedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if false;
      allow delete: if isValidId(resultId) && isAdmin();
    }

    // --- Collection: user_vocabulary ---
    match /user_vocabulary/{vocabDocId} {
      allow get: if isValidId(vocabDocId) && (
        isAdmin()
        || (
          isSignedIn() && (
            (resource == null && isOwnedCompositeId(vocabDocId))
            || (resource != null && existing().uid == request.auth.uid)
          )
        )
      );
      allow list: if (isSignedIn() && existing().uid == request.auth.uid) || isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(vocabDocId)
        && isValidUserVocabulary(incoming())
        && incoming().uid == request.auth.uid
        && vocabDocId == request.auth.uid + '_' + incoming().vocabularyId
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser()
        && isValidId(vocabDocId)
        && isValidUserVocabulary(incoming())
        && (
          (
            existing().uid == request.auth.uid
            && incoming().uid == existing().uid
            && incoming().vocabularyId == existing().vocabularyId
            && incoming().lessonId == existing().lessonId
            && incoming().levelId == existing().levelId
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['isFavorite', 'isLearned', 'updatedAt'])
          )
          || isAdmin()
        );
      allow delete: if isValidId(vocabDocId) && ((isVerifiedUser() && existing().uid == request.auth.uid) || isAdmin());
    }

    // --- Collection: leaderboard (Public PII-Free Learner Completion Ranking) ---
    match /leaderboard/{userId} {
      allow get: if isValidId(userId) && (
        isOwner(userId)
        || isAdmin()
        || (resource != null && existing().isPublic == true)
      );
      allow list: if existing().isPublic == true || isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == userId
        && (request.auth.uid == userId || isAdmin())
        && (!('firstLoginAt' in incoming()) || incoming().firstLoginAt <= request.time)
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(userId));
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          (
            isOwner(userId)
            && (!('firstLoginAt' in incoming()) || incoming().firstLoginAt <= request.time)
            && (!('firstLoginAt' in existing()) || incoming().firstLoginAt == existing().firstLoginAt)
            && (!('totalAccessSeconds' in existing()) || !('totalAccessSeconds' in incoming()) || incoming().totalAccessSeconds >= existing().totalAccessSeconds)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName', 'currentLevel', 'completedLessons', 'totalLessons',
              'completionPercent', 'learnedVocabCount', 'averageQuizScore',
              'streakDays', 'gemsEarned', 'totalAccessSeconds', 'firstLoginAt', 'pilotEquipped', 'isPublic', 'updatedAt'
            ])
          )
          || isAdmin()
        );
      allow delete: if isValidId(userId) && ((isVerifiedUser() && isOwner(userId)) || isAdmin());
    }

    // --- Collection: user_feedback (Learner Feedback & Admin Triage, PII Isolated) ---
    match /user_feedback/{feedbackId} {
      allow get: if isValidId(feedbackId) && (
        isAdmin()
        || (isSignedIn() && resource != null && existing().uid == request.auth.uid)
      );
      allow list: if (isSignedIn() && existing().uid == request.auth.uid) || isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(feedbackId)
        && isValidUserFeedback(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'new'
        && incoming().adminNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isAdmin()
        && isValidId(feedbackId)
        && isValidUserFeedback(incoming())
        && incoming().uid == existing().uid
        && incoming().userName == existing().userName
        && incoming().userEmail == existing().userEmail
        && incoming().userLevel == existing().userLevel
        && incoming().category == existing().category
        && incoming().contextPage == existing().contextPage
        && incoming().title == existing().title
        && incoming().content == existing().content
        && incoming().rating == existing().rating
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);
      allow delete: if isValidId(feedbackId) && isAdmin();
    }

    // --- Collection: reading_passages (Bilingual Reading Comprehension Flashcards) ---
    match /reading_passages/{passageId} {
      allow get: if isValidId(passageId) && (
        isAdmin()
        || (isSignedIn() && resource != null && existing().isPublished == true)
      );
      allow list: if (isSignedIn() && existing().isPublished == true) || isAdmin();
      allow create: if isAdmin()
        && isValidId(passageId)
        && isValidReadingPassage(incoming())
        && incoming().passageId == passageId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(passageId)
        && isValidReadingPassage(incoming())
        && incoming().passageId == existing().passageId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'titleEn', 'titleVi', 'levelId', 'category', 'contentEn', 'contentVi',
          'keyPhrases', 'estimatedMinutes', 'order', 'isPublished', 'updatedAt'
        ]);
      allow delete: if isValidId(passageId) && isAdmin();
    }

    // --- Collection: club_members (3D English Club PII-Free Avatar Presence) ---
    match /club_members/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isVerifiedUser()
        && !isRevokedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidClubMember(incoming())
        && incoming().uid == userId
        && incoming().joinedAt == request.time
        && incoming().lastActiveAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser()
        && !isRevokedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidClubMember(incoming())
        && incoming().uid == existing().uid
        && incoming().joinedAt == existing().joinedAt
        && incoming().lastActiveAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'currentLevel', 'avatarGender', 'pilotEquipped', 'statusText',
          'posX', 'posZ', 'rotationY', 'isOnline', 'lastActiveAt'
        ]);
      allow delete: if isValidId(userId) && ((isVerifiedUser() && isOwner(userId)) || isAdmin());
    }

    // --- Collection: club_messages (Private 1-on-1 3D Club English Chat) ---
    match /club_messages/{messageId} {
      allow get: if isValidId(messageId) && (
        isAdmin()
        || (isSignedIn() && resource != null && request.auth.uid in existing().participants)
      );
      allow list: if (isSignedIn() && request.auth.uid in existing().participants) || isAdmin();
      allow create: if isVerifiedUser()
        && !isRevokedUser()
        && isValidId(messageId)
        && isValidClubMessage(incoming())
        && incoming().senderUid == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if false;
      allow delete: if isValidId(messageId) && ((isVerifiedUser() && existing().senderUid == request.auth.uid) || isAdmin());
    }

    // --- Collection: club_settings (3D English Club Global Background Music Config) ---
    match /club_settings/{configId} {
      allow get: if isValidId(configId) && configId == 'music' && isSignedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(configId)
        && configId == 'music'
        && isValidClubMusicConfig(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(configId)
        && configId == 'music'
        && isValidClubMusicConfig(incoming())
        && incoming().configId == existing().configId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'mode', 'title', 'artist', 'audioUrl', 'fileName', 'storedFileName',
          'mimeType', 'fileSizeBytes', 'defaultVolume', 'enabled',
          'updatedBy', 'updatedByName', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(configId) && configId == 'music';
    }

    // --- Collection: pilot_hangar (Per-User 3D Pilot Wardrobe & Gem Ledger) ---
    match /pilot_hangar/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && !isRevokedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPilotHangar(incoming())
        && incoming().uid == userId
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && !isRevokedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidPilotHangar(incoming())
        && incoming().uid == existing().uid
        && incoming().spentGems >= existing().spentGems
        && incoming().bonusGems >= existing().bonusGems
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'ownedItemIds', 'equipped', 'spentGems', 'bonusGems', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isAdmin();
    }

    // --- Collection: toeic_groups (PII-Free TOEIC Study Groups & Live Battles) ---
    match /toeic_groups/{groupId} {
      allow get: if isValidId(groupId) && isSignedIn();
      allow list: if isAdmin() || (
        isSignedIn() && (
          existing().isPublic == true
          || request.auth.uid in existing().memberUids
        )
      );
      allow create: if isVerifiedUser()
        && !isRevokedUser()
        && isValidId(groupId)
        && isValidToeicGroup(incoming())
        && incoming().groupId == groupId
        && incoming().creatorUid == request.auth.uid
        && incoming().memberUids.size() == 1
        && request.auth.uid in incoming().memberUids
        && incoming().members.keys().hasOnly([request.auth.uid])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser()
        && !isRevokedUser()
        && isValidId(groupId)
        && isValidToeicGroup(incoming())
        && incoming().groupId == existing().groupId
        && incoming().creatorUid == existing().creatorUid
        && incoming().inviteCode == existing().inviteCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          // Action 1: Creator updates group settings
          || (
            existing().creatorUid == request.auth.uid
            && request.auth.uid in existing().memberUids
            && incoming().maxMembers >= existing().memberUids.size()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'description', 'targetScore', 'maxMembers', 'isPublic', 'badge', 'updatedAt'
            ])
          )
          // Action 2: Verified learner joins group (adds only self, cannot alter other members)
          || (
            !(request.auth.uid in existing().memberUids)
            && existing().memberUids.size() < existing().maxMembers
            && request.auth.uid in incoming().memberUids
            && incoming().memberUids.size() == existing().memberUids.size() + 1
            && incoming().memberUids.hasAll(existing().memberUids)
            && incoming().members.diff(existing().members).affectedKeys().hasOnly([request.auth.uid])
            && request.auth.uid in incoming().members
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'members', 'updatedAt'])
          )
          // Action 3: Non-creator member leaves group (removes only self, cannot alter other members)
          || (
            request.auth.uid in existing().memberUids
            && existing().creatorUid != request.auth.uid
            && !(request.auth.uid in incoming().memberUids)
            && incoming().memberUids.size() == existing().memberUids.size() - 1
            && existing().memberUids.hasAll(incoming().memberUids)
            && incoming().members.diff(existing().members).affectedKeys().hasOnly([request.auth.uid])
            && !(request.auth.uid in incoming().members)
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'members', 'updatedAt'])
          )
          // Action 4: Creator removes another member
          || (
            existing().creatorUid == request.auth.uid
            && request.auth.uid in incoming().memberUids
            && incoming().memberUids.size() == existing().memberUids.size() - 1
            && existing().memberUids.hasAll(incoming().memberUids)
            && existing().members.keys().hasAll(incoming().members.keys())
            && incoming().members.size() == existing().members.size() - 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'members', 'updatedAt'])
          )
        );
      allow delete: if isValidId(groupId) && (
        isAdmin()
        || (isVerifiedUser() && !isRevokedUser() && existing().creatorUid == request.auth.uid)
      );

      // Subcollection: shared_vocab (Real-Time Shared TOEIC Vocabulary)
      match /shared_vocab/{entryId} {
        allow get: if isValidId(groupId) && isValidId(entryId) && (isAdmin() || isToeicGroupMember(groupId));
        allow list: if isAdmin() || isToeicGroupMember(groupId);
        allow create: if isVerifiedUser()
          && !isRevokedUser()
          && isValidId(groupId)
          && isValidId(entryId)
          && isValidToeicGroupVocab(incoming())
          && incoming().entryId == entryId
          && incoming().groupId == groupId
          && incoming().sharedByUid == request.auth.uid
          && incoming().likedByUids.size() == 0
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isToeicGroupMember(groupId);
        allow update: if isVerifiedUser()
          && !isRevokedUser()
          && isValidId(groupId)
          && isValidId(entryId)
          && isValidToeicGroupVocab(incoming())
          && incoming().entryId == existing().entryId
          && incoming().groupId == existing().groupId
          && incoming().sharedByUid == existing().sharedByUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            // Action 1: Group member toggles ONLY their own UID in likedByUids
            || (
              isToeicGroupMember(groupId)
              && incoming().diff(existing()).affectedKeys().hasOnly(['likedByUids', 'updatedAt'])
              && (
                (
                  !(request.auth.uid in existing().likedByUids)
                  && request.auth.uid in incoming().likedByUids
                  && incoming().likedByUids.size() == existing().likedByUids.size() + 1
                  && incoming().likedByUids.hasAll(existing().likedByUids)
                )
                || (
                  request.auth.uid in existing().likedByUids
                  && !(request.auth.uid in incoming().likedByUids)
                  && incoming().likedByUids.size() == existing().likedByUids.size() - 1
                  && existing().likedByUids.hasAll(incoming().likedByUids)
                )
              )
            )
            // Action 2: Author updates note or examples
            || (
              existing().sharedByUid == request.auth.uid
              && isToeicGroupMember(groupId)
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'noteVi', 'meaningVi', 'exampleEn', 'exampleVi', 'updatedAt'
              ])
            )
          );
        allow delete: if isValidId(groupId) && isValidId(entryId) && (
          isAdmin()
          || (
            isVerifiedUser()
            && !isRevokedUser()
            && (
              (existing().sharedByUid == request.auth.uid && isToeicGroupMember(groupId))
              || isToeicGroupCreator(groupId)
            )
          )
        );
      }

      // Subcollection: challenges (Real-Time Synchronized TOEIC Quiz Battles)
      match /challenges/{challengeId} {
        allow get: if isValidId(groupId) && isValidId(challengeId) && (isAdmin() || isToeicGroupMember(groupId));
        allow list: if isAdmin() || isToeicGroupMember(groupId);
        allow create: if isVerifiedUser()
          && !isRevokedUser()
          && isValidId(groupId)
          && isValidId(challengeId)
          && isValidToeicGroupChallenge(incoming())
          && incoming().challengeId == challengeId
          && incoming().groupId == groupId
          && incoming().hostUid == request.auth.uid
          && incoming().status == 'waiting'
          && incoming().startedAtMs == 0
          && incoming().participantUids.size() == 1
          && request.auth.uid in incoming().participantUids
          && incoming().participants.keys().hasOnly([request.auth.uid])
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && isToeicGroupMember(groupId);
        allow update: if isVerifiedUser()
          && !isRevokedUser()
          && isValidId(groupId)
          && isValidId(challengeId)
          && isValidToeicGroupChallenge(incoming())
          && incoming().challengeId == existing().challengeId
          && incoming().groupId == existing().groupId
          && incoming().hostUid == existing().hostUid
          && incoming().hostName == existing().hostName
          && incoming().questionCount == existing().questionCount
          && incoming().timeLimitSeconds == existing().timeLimitSeconds
          && !('questions' in incoming().diff(existing()).affectedKeys())
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            isAdmin()
            // Action 1: Group member joins waiting or active challenge (adds only self)
            || (
              existing().status != 'finished'
              && isToeicGroupMember(groupId)
              && !(request.auth.uid in existing().participantUids)
              && request.auth.uid in incoming().participantUids
              && incoming().participantUids.size() == existing().participantUids.size() + 1
              && incoming().participantUids.hasAll(existing().participantUids)
              && incoming().participants.diff(existing().participants).affectedKeys().hasOnly([request.auth.uid])
              && request.auth.uid in incoming().participants
              && incoming().diff(existing()).affectedKeys().hasOnly(['participantUids', 'participants', 'updatedAt'])
            )
            // Action 2: Host starts the live quiz battle (waiting -> active)
            || (
              existing().status == 'waiting'
              && existing().hostUid == request.auth.uid
              && isToeicGroupMember(groupId)
              && incoming().status == 'active'
              && incoming().startedAtMs > 0
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'startedAtMs', 'updatedAt'])
            )
            // Action 3: Participant updates ONLY their own progress/score/ready state
            || (
              existing().status != 'finished'
              && isToeicGroupMember(groupId)
              && request.auth.uid in existing().participantUids
              && incoming().participants.keys().hasAll(existing().participants.keys())
              && incoming().participants.keys().hasOnly(existing().participants.keys())
              && incoming().participants.diff(existing().participants).affectedKeys().hasOnly([request.auth.uid])
              && incoming().diff(existing()).affectedKeys().hasOnly(['participants', 'updatedAt'])
            )
            // Action 4: Host or finishing participant marks active challenge finished (terminal lock)
            || (
              existing().status == 'active'
              && isToeicGroupMember(groupId)
              && request.auth.uid in existing().participantUids
              && incoming().status == 'finished'
              && incoming().participants.keys().hasAll(existing().participants.keys())
              && incoming().participants.keys().hasOnly(existing().participants.keys())
              && (
                incoming().participants == existing().participants
                || incoming().participants.diff(existing().participants).affectedKeys().hasOnly([request.auth.uid])
              )
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'participants', 'updatedAt'])
            )
          );
        allow delete: if isValidId(groupId) && isValidId(challengeId) && (
          isAdmin()
          || (
            isVerifiedUser()
            && !isRevokedUser()
            && (
              (existing().hostUid == request.auth.uid && isToeicGroupMember(groupId))
              || isToeicGroupCreator(groupId)
            )
          )
        );
      }
    }
  }
}
